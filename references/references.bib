@article{cretney2024,
  title = {Navigating adaptive futures: analysing the scope of political possibilities for climate adaptation},
  shorttitle = {Navigating adaptive futures},
  author = {Cretney, Raven and White, Iain and Hanna, Christina},
  date = {2024-05-12},
  journaltitle = {Kōtuitui: New Zealand Journal of Social Sciences Online},
  pages = {1--22},

@article{dunlap2024,
  title = {The political ecologies of "green" extractivism(s): An introduction},
  shorttitle = {The political ecologies of "green" extractivism(s)},
  author = {Dunlap, Alexander and Verweijen, Judith and Tornel, Carlos},
  date = {2024-07-23},
  journaltitle = {Journal of Political Ecology},
  volume = {31},
  number = {1},
  issn = {1073-0451},
  doi = {10.2458/jpe.6131},
  url = {http://journals.librarypublishing.arizona.edu/jpe/article/id/6131/},
  urldate = {2025-06-09},
  abstract = {What is so-called 'green' extractivism and where did it come from? The introduction to this Special Section examines the origins and implications of the concept, linking it to a long history of exploitation, dispossession and (neo)colonialism under the guise of green-washing notions such as 'sustainable development.' Conducting an in-depth literature review, we first revisit the concept of extractivism, exploring its origins, development and analytical purchase. We link extractivism to 'extra-action,' implying taking more than what is viable for ecosystems and argue for a supply-web oriented, rather than a point of extraction-focused understanding. Subsequently, we examine key theoretical frameworks in political ecology that paved the way to the study of 'green' extractivism, notably Ecological Distribution Conflicts (which we argue could better be labeled Ecological Destruction Conflicts) and green grabbing. Based on this, we discuss the core features of green extractivism, which are twofold: (1) the use of socioecological and climate crises to reinforce existing or generate new markets and profit-generation opportunities; and (2) the mobilization of claims of ecological sustainability and 'carbon neutrality' to legitimize and rationalize extraction. After outlining the Special Section contributions, we end by considering gaps in existing scholarship on green extractivism and suggest ways forward.},
  file = {C:\Users\nilsn\Zotero\storage\UBR5W59E\dunlap2024.pdf}
}

@article{dunlap2025,
